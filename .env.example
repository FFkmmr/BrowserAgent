# API Configuration
# Для z.ai (GLM-4 и другие модели)
API_KEY=your_api_key_here
API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MODEL_NAME=glm-4

# Для Groq (OpenAI-compatible)
# API_KEY=gsk_your_groq_key_here
# API_BASE_URL=https://api.groq.com/openai/v1
# MODEL_NAME=llama-3.3-70b-versatile

# Для Claude (Anthropic) - раскомментируйте если используете Claude
# API_KEY=sk-ant-api03-your-key-here
# API_BASE_URL=https://api.anthropic.com/v1
# MODEL_NAME=claude-3-5-sonnet-20241022

# Для OpenAI - раскомментируйте если используете OpenAI
# API_KEY=sk-your-openai-key-here
# API_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4-turbo-preview

# Agent Configuration
MAX_STEPS=50
TIMEOUT_SECONDS=300
HEADLESS=false

# Browser Configuration
BROWSER_TYPE=chromium
# Use system Google Chrome instead of bundled Chromium (Playwright)
# BROWSER_CHANNEL=chrome
# Attach to an already running Chrome with DevTools enabled (so extension runs in the same browser)
# CHROME_CDP_URL=http://127.0.0.1:9222
# Fail fast if CDP endpoint isn't reachable
# CDP_CONNECT_TIMEOUT_SECONDS=5
SLOW_MO=100

# Debug: keep browser open after run
KEEP_BROWSER_OPEN=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log

# Extension Communication (optional)
WEBSOCKET_PORT=8765
